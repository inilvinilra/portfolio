          <span class="stack-item">TypeScript</span>
          <span class="stack-item">JavaScript</span>
          <span class="stack-item">Python</span>
          <span class="stack-item">Go</span>
          <span class="stack-item">Rust</span>
          <span class="stack-item">Bash</span>
          <span class="stack-item">Node.js</span>
        </div>
      </div>

      <div class="stack-category">
        <h3 data-i18n="stack_backend">Бэкенд, фронтенд и данные</h3>
        <div class="stack-items">
          <span class="stack-item">NestJS</span>
          <span class="stack-item">Next.js</span>
          <span class="stack-item">React</span>
          <span class="stack-item">PostgreSQL</span>
          <span class="stack-item">Redis</span>
          <span class="stack-item">Prisma</span>
          <span class="stack-item">RabbitMQ</span>
        </div>
      </div>

      <div class="stack-category">
        <h3 data-i18n="stack_infra">Инфраструктура и операции</h3>
        <div class="stack-items">
          <span class="stack-item">Docker</span>
